{
  "name": "sport-center-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "axios": "^1.20.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.19",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.52.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "test-renderer": "1.2.0",
    "typescript": "~6.0.3",
    "yaml": "2.9.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:unit": "jest --runInBand --testPathPattern=__tests__",
    "test:integration": "jest --runInBand --testPathPattern=tests/integration",
    "test:regression": "npm run test:ci",
    "test:api": "node scripts/run-api-tests.js",
    "test:acceptance": "maestro test .maestro",
    "test:config": "node scripts/validate-test-configs.js",
    "test:load": "node -e \"require('fs').mkdirSync('test-results', { recursive: true })\" && k6 run tests/performance/load.js",
    "test:stress": "node -e \"require('fs').mkdirSync('test-results', { recursive: true })\" && k6 run tests/performance/stress.js",
    "test:ci": "node -e \"require('fs').mkdirSync('test-results', { recursive: true })\" && jest --ci --runInBand --coverage --verbose --json --outputFile=test-results/jest.json",
    "validate": "npm run lint && npm run typecheck && npm run test:ci && npm run test:config"
  },
  "private": true,
  "engines": {
    "node": ">=22.20.0"
  }
}
