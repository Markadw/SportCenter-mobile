{
  "expo": {
    "name": "Sport Center",
    "slug": "sport-center-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/sport-center-icon.png",
    "scheme": "sportcentermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/sport-center-icon.png",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/sport-center-icon.png",
        "backgroundColor": "#0367A6"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.markadw.sportcenter",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/sport-center-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/logo/logo-sport.png",
          "imageWidth": 240
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "usesCleartextTraffic": false,
            "extraProguardRules": "# React Native y Expo aportan sus reglas consumer; no se agregan reglas keep globales.\n-keepattributes SourceFile,LineNumberTable"
          }
        }
      ],
      "./plugins/with-network-security"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c608a591-dfad-47d6-98cf-e714e821c269"
      }
    },
    "owner": "anth.oi"
  }
}
